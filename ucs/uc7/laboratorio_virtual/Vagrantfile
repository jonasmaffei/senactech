# -*- mode: ruby -*-
# vi: set ft=ruby :

# ============================================================
# UC7 - Laboratorio VirtualBox + Vagrant
# ============================================================
# Boxes podem ser trocadas por variaveis de ambiente:
#   set UC7_WIN_SERVER_BOX=gusztavvargadr/windows-server-2022-standard
#   set UC7_WIN_CLIENT_BOX=gusztavvargadr/windows-11
#   set UC7_LINUX_BOX=bento/ubuntu-24.04
#
# Exemplo no PowerShell:
#   $env:UC7_WIN_SERVER_BOX="gusztavvargadr/windows-server-2025-standard"
#   vagrant up
# ============================================================

WIN_SERVER_BOX = ENV.fetch("UC7_WIN_SERVER_BOX", "gusztavvargadr/windows-server-2022-standard")
WIN_CLIENT_BOX = ENV.fetch("UC7_WIN_CLIENT_BOX", "gusztavvargadr/windows-11")
LINUX_BOX      = ENV.fetch("UC7_LINUX_BOX", "bento/ubuntu-24.04")

INTNET = "rede-nexatech"

Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  config.vm.boot_timeout = 1200
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.synced_folder ".", "C:/vagrant", disabled: true

  # ----------------------------------------------------------
  # DC01 - Windows Server (controlador de dominio)
  # ----------------------------------------------------------
  config.vm.define "dc01" do |dc|
    dc.vm.box = WIN_SERVER_BOX
    dc.vm.hostname = "DC01"
    dc.vm.communicator = "winrm"
    dc.vm.winrm.username = "vagrant"
    dc.vm.winrm.password = "vagrant"
    dc.vm.network "private_network", ip: "192.168.10.10", virtualbox__intnet: INTNET
    dc.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1", id: "http_dc01"
    dc.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1", id: "https_dc01"

    dc.vm.provider "virtualbox" do |vb|
      vb.memory = 4096
      vb.cpus = 2
      vb.gui = false
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    dc.vm.provision "shell",
      path: "provision/dc01/01-baseline.ps1",
      name: "DC01 - configuracao inicial"
  end

  # ----------------------------------------------------------
  # LNX01 - Ubuntu Server (servicos Linux)
  # ----------------------------------------------------------
  config.vm.define "lnx01" do |lnx|
    lnx.vm.box = LINUX_BOX
    lnx.vm.hostname = "lnx01"
    lnx.vm.network "private_network", ip: "192.168.10.20", virtualbox__intnet: INTNET
    lnx.vm.network "forwarded_port", guest: 80, host: 8081, host_ip: "127.0.0.1", id: "http_lnx01"
    lnx.vm.network "forwarded_port", guest: 443, host: 8444, host_ip: "127.0.0.1", id: "https_lnx01"

    lnx.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
      vb.gui = false
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    lnx.vm.provision "shell",
      path: "provision/linux/01-baseline.sh",
      args: ["lnx01"],
      name: "LNX01 - configuracao inicial"
  end

  # ----------------------------------------------------------
  # MON01 - Ubuntu Server (monitoramento)
  # ----------------------------------------------------------
  config.vm.define "mon01" do |mon|
    mon.vm.box = LINUX_BOX
    mon.vm.hostname = "mon01"
    mon.vm.network "private_network", ip: "192.168.10.30", virtualbox__intnet: INTNET
    mon.vm.network "forwarded_port", guest: 80, host: 8082, host_ip: "127.0.0.1", id: "http_mon01"
    mon.vm.network "forwarded_port", guest: 3000, host: 3000, host_ip: "127.0.0.1", id: "grafana_mon01"

    mon.vm.provider "virtualbox" do |vb|
      vb.memory = 2048
      vb.cpus = 2
      vb.gui = false
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    mon.vm.provision "shell",
      path: "provision/linux/01-baseline.sh",
      args: ["mon01"],
      name: "MON01 - configuracao inicial"
  end

  # ----------------------------------------------------------
  # CLI01 - Windows 11 (cliente)
  # ----------------------------------------------------------
  config.vm.define "cli01" do |cli|
    cli.vm.box = WIN_CLIENT_BOX
    cli.vm.hostname = "CLI01"
    cli.vm.communicator = "winrm"
    cli.vm.winrm.username = "vagrant"
    cli.vm.winrm.password = "vagrant"
    cli.vm.network "private_network", ip: "192.168.10.100", virtualbox__intnet: INTNET

    cli.vm.provider "virtualbox" do |vb|
      vb.memory = 4096
      vb.cpus = 2
      vb.gui = false
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--nictype2", "82540EM"]
    end

    cli.vm.provision "shell",
      path: "provision/cli01/01-baseline.ps1",
      name: "CLI01 - configuracao inicial"
  end
end
